# 复制为 .env.local 后填入实际值
# .env.local 不会进版本库；只排盘不玩 AI 的话可以完全跳过本文件。

# ─── AI 推理（OpenAI 兼容协议，任选一家）───
# 本 fork 已实现 /api/interpret（命盘解读）与 /api/heming（合盘分析）。
AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=your-deepseek-api-key

# 可选调参
# AI_MAX_TOKENS=2048
# AI_TEMPERATURE=0.7
# AI_TIMEOUT_MS=120000

# ─── 预设：openai / ollama（本地，无需 Key）───
# AI_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# AI_MODEL=gpt-4o-mini

# AI_PROVIDER=ollama
# AI_BASE_URL=http://127.0.0.1:11434/v1
# AI_MODEL=qwen2.5:14b

# ─── 或用其他任意 OpenAI 兼容服务（通用变量）───
# AI_PROVIDER=custom
# AI_API_KEY=your-api-key
# AI_BASE_URL=https://your-provider/v1
# AI_MODEL=model-name

# ─── 站点 ───
NEXT_PUBLIC_SITE_URL=http://localhost:3000
